{
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(xcodebuild test *)",
      "Bash(xcodebuild build *)",
      "Bash(xcodebuild -project *)",
      "Bash(xcodebuild -scheme *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [[ \"$CLAUDE_TOOL_INPUT_FILE_PATH\" == *GoogleService-Info.plist || \"$CLAUDE_TOOL_INPUT_FILE_PATH\" == */.firebaserc ]]; then echo 'Blocked: Firebase config files must not be edited by Claude'; exit 2; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [[ \"$CLAUDE_TOOL_INPUT_FILE_PATH\" == *.swift ]]; then swiftlint lint --quiet \"$CLAUDE_TOOL_INPUT_FILE_PATH\"; fi"
          },
          {
            "type": "command",
            "command": "if [[ \"$CLAUDE_TOOL_INPUT_FILE_PATH\" == *.swift ]]; then swift format -i \"$CLAUDE_TOOL_INPUT_FILE_PATH\"; fi"
          }
        ]
      }
    ]
  }
}
